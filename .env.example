# Copy this to .env and fill in your values
# .env is gitignored — never commit real keys

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Webhook HMAC secret — generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-strong-secret

# Port the gateway listens on inside the container
WEBHOOK_PORT=8644

# Crawl artifacts are written here inside the container
CRAWL_OUTPUT_DIR=/crawls
